# Supabase (públicas, accesibles desde el navegador)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase — service role (SOLO servidor, nunca con prefijo NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=

# Mercado Pago (SOLO servidor, nunca exponer en el navegador)
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# Agente de IA — prompt del sistema (opcional).
# Si se define, reemplaza por completo el prompt predeterminado del Agente Matero.
# Si se omite, se usa el prompt optimizado incluido en src/lib/ai/prompt.ts.
# AI_SYSTEM_PROMPT=

# Origen absoluto del sitio para back_urls / notification_url
# (si se omite, se usa el baseUrl de src/data/site.ts)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
