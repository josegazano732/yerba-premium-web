# Supabase (públicas, accesibles desde el navegador)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase — service role (SOLO servidor, nunca con prefijo NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=

# Ualá — API Cobros Online v2 (SOLO servidor, nunca exponer en el navegador)
# UALA_API_ENV: "test" (stage) o "production" (por defecto).
UALA_API_ENV=test
UALA_USERNAME=
UALA_CLIENT_ID=
UALA_CLIENT_SECRET_ID=
# Opcionales: sobrescriben las URLs base según el entorno.
# UALA_AUTH_BASE_URL=
# UALA_CHECKOUT_BASE_URL=

# Agente de IA — prompt del sistema (opcional).
# Si se define, reemplaza por completo el prompt predeterminado del Agente Matero.
# Si se omite, se usa el prompt optimizado incluido en src/lib/ai/prompt.ts.
# AI_SYSTEM_PROMPT=

# Origen absoluto del sitio para back_urls / notification_url
# (si se omite, se usa el baseUrl de src/data/site.ts)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Maps Locator Plus (restringir la API key por dominio)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# Feature flags de tienda (modulos opcionales)
# true/false | 1/0 | on/off
NEXT_PUBLIC_FEATURE_KIT_BUILDER_3D=false
